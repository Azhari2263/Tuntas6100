/**
 * =============================================================================
 * APLIKASI TUNTAS (TATA KELOLA DAN ADMINISTRASI SURAT TUGAS)
 * BADAN PUSAT STATISTIK PROVINSI KALIMANTAN BARAT
 * 
 * File: DocumentGenerator.gs
 * Fungsi: Engine Pembuatan Dokumen (Google Docs & PDF), Multi-Layout (Tunggal & Kolektif),
 *         Preservasi Presisi Ukuran F4 & Template Resmi BPS Kalbar.
 * =============================================================================
 */

// Logo BPS Resmi Base64 (untuk fallback mode scratch)
const BPS_LOGO_BASE64 = "";

/**
 * Fungsi utama untuk menghasilkan dokumen Surat Tugas (Google Docs & PDF)
 */
function generateSuratTugasDocument(payload, nomorData) {
  // Deteksi Mode: Tunggal (1 Orang) vs Kolektif (> 1 Orang)
  const isSingle = payload.pegawaiList.length === 1;

  // 1. Dapatkan Template ID yang sesuai (Individu vs Kolektif)
  let templateId = "";
  if (isSingle) {
    templateId = payload.templateIndividuId || 
                 getSystemProperty("TEMPLATE_INDIVIDU_DOC_ID", "") || 
                 CONFIG.TEMPLATE_INDIVIDU_DOC_ID || 
                 payload.templateDocId || 
                 CONFIG.TEMPLATE_DOC_ID || 
                 getSystemProperty("TEMPLATE_DOC_ID", "");
  } else {
    templateId = payload.templateKolektifId || 
                 getSystemProperty("TEMPLATE_KOLEKTIF_DOC_ID", "") || 
                 CONFIG.TEMPLATE_KOLEKTIF_DOC_ID || 
                 payload.templateDocId || 
                 CONFIG.TEMPLATE_DOC_ID || 
                 getSystemProperty("TEMPLATE_DOC_ID", "");
  }

  let rootFolderId = payload.driveRootFolderId || CONFIG.DRIVE_ROOT_FOLDER_ID || getSystemProperty("DRIVE_ROOT_FOLDER_ID", "");

  // 2. Siapkan Folder Tujuan Terstruktur di Google Drive
  const targetFolder = resolveTargetDriveFolder(rootFolderId, payload, nomorData);

  // 3. Nama Dokumen
  const cleanNomor = nomorData.nomorSurat.replace(/[\/\\:]/g, "_");
  const docTitle = cleanNomor + " - Surat Tugas";
  const pdfTitle = cleanNomor + "_Surat_Tugas.pdf";

  let newDocFile = null;

  // 4. Periksa apakah Template ID valid dan dapat diakses
  if (templateId && templateId.trim() !== "") {
    try {
      newDocFile = cloneGoogleDocTemplate(templateId.trim(), docTitle, targetFolder);
    } catch (err) {
      Logger.log("Peringatan: Gagal mengkloning template (" + err.message + "). Menggunakan engine presisi mandiri.");
      newDocFile = createDocumentFromScratch(docTitle, targetFolder, payload, nomorData);
    }
  } else {
    // Jika belum ada template ID yang diset, buat dokumen baru presisi dari scratch
    newDocFile = createDocumentFromScratch(docTitle, targetFolder, payload, nomorData);
  }

  // 5. Modifikasi Dokumen Google Docs yang Baru
  const doc = DocumentApp.openById(newDocFile.getId());
  const body = doc.getBody();

  // Substitusi Variabel / Placeholder Standar pada Template
  populateDocumentVariables(body, payload, nomorData);

  // Bersihkan pemformatan tebal (bold) yang tidak perlu pada naskah
  cleanUpStrayBold(body);

  if (isSingle) {
    applySinglePersonLayout(body, payload.pegawaiList[0]);
  } else {
    applyCollectivePersonLayout(body, payload.pegawaiList, payload);
  }

  // Tangani Konsiderans Menimbang b (opsional toggle)
  handleMenimbangClauseB(body, payload.includeMenimbangB);

  // Tangani Pejabat Penandatangan
  handleSignatoryBlock(body, payload);

  // Bersihkan seluruh trailing empty paragraphs dan PageBreak berlebih di akhir dokumen
  // baik pada surat tugas tunggal maupun kolektif agar tidak memunculkan halaman kosong tambahan
  cleanTrailingEmptyParagraphs(body);

  // Simpan dan tutup dokumen Google Docs
  doc.saveAndClose();

  // Bersihkan Section Break sisa/berlebih via Docs API agar dokumen tepat 1 halaman (tunggal) atau 2 halaman (kolektif)
  cleanExcessSectionBreaksViaApi(newDocFile.getId(), isSingle);

  // Perbarui referensi berkas agar PDF mengambil versi paling bersih terkini
  newDocFile = DriveApp.getFileById(newDocFile.getId());

  // 6. Ekspor ke Berkas Resmi PDF
  const pdfBlob = newDocFile.getAs("application/pdf").setName(pdfTitle);
  const pdfFile = targetFolder.createFile(pdfBlob);

  // Berikan hak akses tampilan publik/domain
  try {
    pdfFile.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
    newDocFile.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
  } catch (e) {
    // Abaikan jika kebijakan domain melarang public link sharing
  }

  return {
    docId: newDocFile.getId(),
    docUrl: newDocFile.getUrl(),
    pdfId: pdfFile.getId(),
    pdfUrl: pdfFile.getUrl(),
    folderId: targetFolder.getId(),
    folderUrl: targetFolder.getUrl()
  };
}

/**
 * Mengkloning file template, dengan penanganan otomatis jika file masih format .DOCX
 */
function cloneGoogleDocTemplate(templateId, docTitle, targetFolder) {
  const file = DriveApp.getFileById(templateId);
  const mimeType = file.getMimeType();

  // Jika sudah berupa Google Dokumen asli
  if (mimeType === MimeType.GOOGLE_DOCS) {
    return file.makeCopy(docTitle, targetFolder);
  }

  // Jika file di Drive masih format .docx (Office Compatibility Mode)
  if (mimeType === "application/vnd.openxmlformats-officedocument.wordprocessingml.document" || 
      file.getName().toLowerCase().endsWith(".docx")) {
    
    // Coba konversi via Drive API v2 copy convert=true
    try {
      const copyUrl = "https://www.googleapis.com/drive/v2/files/" + templateId + "/copy?convert=true";
      const response = UrlFetchApp.fetch(copyUrl, {
        method: "post",
        headers: { "Authorization": "Bearer " + ScriptApp.getOAuthToken() },
        contentType: "application/json",
        payload: JSON.stringify({
          title: docTitle,
          parents: [{ id: targetFolder.getId() }]
        }),
        muteHttpExceptions: true
      });

      const resJson = JSON.parse(response.getContentText());
      if (resJson && resJson.id) {
        return DriveApp.getFileById(resJson.id);
      }
    } catch (convErr) {
      Logger.log("Konversi otomatis Drive API gagal: " + convErr);
    }

    throw new Error(
      "File template di Google Drive masih berformat '.DOCX' (Office Editing). " +
      "Silakan buka file tersebut di Google Drive, klik menu 'File' -> 'Simpan sebagai Google Dokumen'. " +
      "Lalu gunakan ID dari tab Google Dokumen yang baru."
    );
  }

  return file.makeCopy(docTitle, targetFolder);
}

/**
 * Menyusun hierarki folder Google Drive:
 * Root -> [Tahun] -> [Bulan] -> [Nomor Surat & Ringkasan]
 */
function resolveTargetDriveFolder(rootFolderId, payload, nomorData) {
  let rootFolder;
  if (rootFolderId && rootFolderId.trim() !== "") {
    try {
      rootFolder = DriveApp.getFolderById(rootFolderId.trim());
    } catch (e) {
      rootFolder = null;
    }
  }

  if (!rootFolder) {
    const existing = DriveApp.getFoldersByName("ARSIP_SURTUG_BPS_KALBAR");
    if (existing.hasNext()) {
      rootFolder = existing.next();
    } else {
      rootFolder = DriveApp.createFolder("ARSIP_SURTUG_BPS_KALBAR");
    }
  }

  const curYear = String(payload.tahun || new Date().getFullYear());
  const yearFolder = getOrCreateSubFolder(rootFolder, curYear);

  const dateObj = new Date();
  const monthNames = ["01 - Januari", "02 - Februari", "03 - Maret", "04 - April", "05 - Mei", "06 - Juni",
                      "07 - Juli", "08 - Agustus", "09 - September", "10 - Oktober", "11 - November", "12 - Desember"];
  const curMonth = monthNames[dateObj.getMonth()];
  const monthFolder = getOrCreateSubFolder(yearFolder, curMonth);

  let cleanTujuan = payload.tujuanTugas ? payload.tujuanTugas.trim() : "Penugasan";
  cleanTujuan = cleanTujuan.replace(/[^\w\s-]/gi, "").substring(0, 35);
  const specificFolderName = "B-" + nomorData.agenda + " - " + cleanTujuan;

  return getOrCreateSubFolder(monthFolder, specificFolderName);
}

function getOrCreateSubFolder(parentFolder, subFolderName) {
  const folders = parentFolder.getFoldersByName(subFolderName);
  if (folders.hasNext()) {
    return folders.next();
  }
  return parentFolder.createFolder(subFolderName);
}

/**
 * Melakukan penggantian teks / placeholder dalam dokumen
 */
function populateDocumentVariables(body, payload, nomorData) {
  // Nomor Surat Tugas
  const noSurat = nomorData.nomorSurat || "";
  body.replaceText("<<No\\s*Surtug>>", noSurat);
  body.replaceText("<<no\\s*surtug>>", noSurat);
  body.replaceText("\\[NO_SURAT_TUGAS\\]", noSurat);
  body.replaceText("\\[NOMOR_SURAT\\]", noSurat);
  body.replaceText("\\{\\{NOMOR_SURAT\\}\\}", noSurat);

  // Titi Mangsa (Tempat & Tanggal Penetapan)
  const tempat = payload.tempatPenetapan || "Pontianak";
  const tanggal = payload.tanggalPenetapan || formatTanggalIndonesia(new Date());
  body.replaceText("<<Tempat\\s*Pengesahan>>", tempat);
  body.replaceText("<<tempat\\s*pengesahan>>", tempat);
  body.replaceText("<<Tgl\\s*pengesahan>>", tanggal);
  body.replaceText("<<tgl\\s*pengesahan>>", tanggal);
  body.replaceText("\\[TEMPAT_PENETAPAN\\]", tempat);
  body.replaceText("\\[TANGGAL_PENETAPAN\\]", tanggal);
  body.replaceText("\\{\\{TEMPAT_PENETAPAN\\}\\}", tempat);
  body.replaceText("\\{\\{TANGGAL_PENETAPAN\\}\\}", tanggal);

  // Konsiderans Rujukan
  const ttdRujukan = payload.rujukanPejabat || "";
  const noRujukan = payload.rujukanNomor || "";
  const halRujukan = payload.rujukanPerihal || "";
  body.replaceText("<<ttdsuratrujukan>>", ttdRujukan);
  body.replaceText("<<nosuratrujukan>>", noRujukan);
  body.replaceText("<<halsrtrujukan>>", halRujukan);
  body.replaceText("\\[TTD_SURAT_RUJUKAN\\]", ttdRujukan);
  body.replaceText("\\[NO_SURAT_RUJUKAN\\]", noRujukan);
  body.replaceText("\\[HAL_SURAT_RUJUKAN\\]", halRujukan);
  body.replaceText("\\{\\{TTD_SURAT_RUJUKAN\\}\\}", ttdRujukan);
  body.replaceText("\\{\\{NO_SURAT_RUJUKAN\\}\\}", noRujukan);
  body.replaceText("\\{\\{HAL_SURAT_RUJUKAN\\}\\}", halRujukan);

  // Rapikan spasi berlebih setelah kata "nomor" pada template
  body.replaceText("nomor\\s{2,}", "nomor ");

  // Uraian Kegiatan "Untuk" & Tanggal Kegiatan
  let rawTujuan = payload.tujuanTugas ? payload.tujuanTugas.trim() : "";
  let cleanTujuan = rawTujuan.replace(/^Mengikuti\s+(Kegiatan\s+)?/i, "").trim();
  if (!cleanTujuan) cleanTujuan = rawTujuan;

  const tglKeg = payload.tglKeg || payload.tanggalKegiatan || "";

  body.replaceText("<<Untuk>>", cleanTujuan);
  body.replaceText("<<untuk>>", cleanTujuan);
  body.replaceText("\\[Tujuan\\]", rawTujuan);
  body.replaceText("\\[TUJUAN\\]", rawTujuan);
  body.replaceText("\\{\\{TUJUAN\\}\\}", rawTujuan);

  if (tglKeg && tglKeg.trim() !== "") {
    body.replaceText("<<tglkeg>>", tglKeg.trim());
    body.replaceText("<<tgl_keg>>", tglKeg.trim());
  } else {
    // Fallback: gunakan tanggal penetapan agar tidak meninggalkan placeholder literal
    body.replaceText("<<tglkeg>>", tanggal);
    body.replaceText("<<tgl_keg>>", tanggal);
  }
}

/**
 * Menangani Layout Surat Tugas Tunggal (1 Orang)
 */
function applySinglePersonLayout(body, person) {
  const nama = person.nama || "";
  const nip = person.nip || "";
  const pangkatGol = person.pangkat_gol || "";
  const jabatan = person.jabatan || "";
  const peran = person.peran || "Peserta";

  // Template Baru <<...>>
  body.replaceText("<<Nama\\s*Penerima>>", nama);
  body.replaceText("<<nama\\s*penerima>>", nama);
  body.replaceText("<<NIP>>", nip);
  body.replaceText("<<nip>>", nip);
  body.replaceText("<<Pangkatgol>>", pangkatGol);
  body.replaceText("<<pangkatgol>>", pangkatGol);
  body.replaceText("<<Jabatan>>", jabatan);
  body.replaceText("<<jabatan>>", jabatan);
  body.replaceText("<<Peran>>", peran);
  body.replaceText("<<peran>>", peran);

  // Template Lama [...] dan {{...}}
  body.replaceText("\\[NAMA_DITUGASKAN\\]", nama);
  body.replaceText("\\[NIP_DITUGASKAN\\]", nip);
  body.replaceText("\\[PANG/GOL_DITUGASKAN\\]", pangkatGol);
  body.replaceText("\\[JABATAN_DITUGASKAN\\]", jabatan);

  body.replaceText("\\{\\{NAMA_DITUGASKAN\\}\\}", nama);
  body.replaceText("\\{\\{NIP_DITUGASKAN\\}\\}", nip);
  body.replaceText("\\{\\{PANG/GOL_DITUGASKAN\\}\\}", pangkatGol);
  body.replaceText("\\{\\{JABATAN_DITUGASKAN\\}\\}", jabatan);

  // Hapus lembar lampiran bawaan template jika ada
  removeLampiranSection(body);
}

/**
 * Menangani Layout Surat Tugas Kolektif (Banyak Orang)
 * Mendukung template dengan tabel terpisah maupun tabel gabungan (Template Surtug.docx bawaan)
 */
function applyCollectivePersonLayout(body, pegawaiList, payload) {
  // Template Baru <<...>>
  body.replaceText("<<Nama\\s*Penerima>>", "(terlampir)");
  body.replaceText("<<nama\\s*penerima>>", "(terlampir)");
  body.replaceText("<<NIP>>", "(terlampir)");
  body.replaceText("<<nip>>", "(terlampir)");
  body.replaceText("<<Pangkatgol>>", "(terlampir)");
  body.replaceText("<<pangkatgol>>", "(terlampir)");
  body.replaceText("<<Jabatan>>", "(terlampir)");
  body.replaceText("<<jabatan>>", "(terlampir)");
  body.replaceText("<<Peran>>", "");
  body.replaceText("<<peran>>", "");

  // Template Lama
  body.replaceText("\\[NAMA_DITUGASKAN\\]", "(terlampir)");
  body.replaceText("\\[NIP_DITUGASKAN\\]", "(terlampir)");
  body.replaceText("\\[PANG/GOL_DITUGASKAN\\]", "(terlampir)");
  body.replaceText("\\[JABATAN_DITUGASKAN\\]", "(terlampir)");

  body.replaceText("\\{\\{NAMA_DITUGASKAN\\}\\}", "(terlampir)");
  body.replaceText("\\{\\{NIP_DITUGASKAN\\}\\}", "(terlampir)");
  body.replaceText("\\{\\{PANG/GOL_DITUGASKAN\\}\\}", "(terlampir)");
  body.replaceText("\\{\\{JABATAN_DITUGASKAN\\}\\}", "(terlampir)");

  const tables = body.getTables();
  let lampiranTable = null;
  let headerRowIndex = -1;

  // Cari tabel lampiran yang memuat kolom daftar pegawai
  for (let i = 0; i < tables.length; i++) {
    const t = tables[i];
    for (let r = 0; r < t.getNumRows(); r++) {
      const rowText = getRowText(t.getRow(r));
      if (rowText.indexOf("Peran") !== -1 && 
          (rowText.indexOf("Nama") !== -1 || rowText.indexOf("NIP") !== -1 || rowText.indexOf("Pangkat") !== -1)) {
        lampiranTable = t;
        headerRowIndex = r;
        break;
      }
    }
    if (lampiranTable) break;
  }

  if (lampiranTable && headerRowIndex !== -1) {
    // 1. Identifikasi apakah baris terakhir tabel adalah blok tanda tangan (seperti pada Template Surtug.docx asli)
    let hasSigRow = false;
    let sigRowIndex = -1;
    const lastRowIndex = lampiranTable.getNumRows() - 1;

    if (lastRowIndex > headerRowIndex) {
      const lastRowText = getRowText(lampiranTable.getRow(lastRowIndex));
      if (lastRowText.indexOf("Kepala") !== -1 || 
          lastRowText.indexOf("Muh Saichudin") !== -1 || 
          lastRowText.indexOf("Pontianak") !== -1 || 
          lastRowText.indexOf("[TEMPAT_PENETAPAN]") !== -1 || 
          lastRowText.indexOf("{{TEMPAT_PENETAPAN}}") !== -1 ||
          (payload && payload.pejabatNama && lastRowText.indexOf(payload.pejabatNama.trim()) !== -1)) {
        hasSigRow = true;
        sigRowIndex = lastRowIndex;
      }
    }

    // 2. Baris data pertama (placeholder bawaan setelah header)
    const firstDataRowIndex = headerRowIndex + 1;
    let prototypeRow = null;

    if (firstDataRowIndex < lampiranTable.getNumRows() && (!hasSigRow || firstDataRowIndex < sigRowIndex)) {
      prototypeRow = lampiranTable.getRow(firstDataRowIndex);
    }

    const headerRow = lampiranTable.getRow(headerRowIndex);
    const colWidths = [];
    if (headerRow) {
      try {
        headerRow.setMinimumHeight(24);
        for (let c = 0; c < headerRow.getNumCells(); c++) {
          headerRow.getCell(c).setVerticalAlignment(DocumentApp.VerticalAlignment.CENTER);
          try {
            colWidths[c] = headerRow.getCell(c).getWidth();
          } catch (eCw) {
            colWidths[c] = null;
          }
        }
      } catch (eH) {}
    }
    const totalPegawai = pegawaiList.length;

    // 3. Masukkan data seluruh pegawai yang dipilih
    pegawaiList.forEach((p, idx) => {
      let row;
      const targetIndex = firstDataRowIndex + idx;

      // Jika baris pada targetIndex sudah ada dan bukan baris tanda tangan, gunakan baris tersebut
      if (targetIndex < (hasSigRow ? sigRowIndex : lampiranTable.getNumRows())) {
        row = lampiranTable.getRow(targetIndex);
      } else {
        // Buat baris baru
        if (prototypeRow) {
          try {
            const cloned = prototypeRow.copy();
            if (hasSigRow) {
              row = lampiranTable.insertTableRow(targetIndex, cloned);
              sigRowIndex++;
            } else {
              row = lampiranTable.appendTableRow(cloned);
            }
          } catch (eClone) {
            row = hasSigRow ? lampiranTable.insertTableRow(targetIndex) : lampiranTable.appendTableRow();
            if (hasSigRow) sigRowIndex++;
          }
        } else {
          row = hasSigRow ? lampiranTable.insertTableRow(targetIndex) : lampiranTable.appendTableRow();
          if (hasSigRow) sigRowIndex++;
        }
      }

      // Pastikan minimal 6 kolom
      while (row.getNumCells() < 6) {
        row.appendTableCell("");
      }

      fillLampiranRow(row, idx, p, headerRow, colWidths);
    });

    // 4. Jika ada sisa baris placeholder berlebih, hapus
    const endDataIndex = firstDataRowIndex + totalPegawai;
    while (endDataIndex < (hasSigRow ? sigRowIndex : lampiranTable.getNumRows())) {
      lampiranTable.removeRow(endDataIndex);
      if (hasSigRow) sigRowIndex--;
    }
  }

  // Rapikan spasi paragraf kosong di sekitar tabel lampiran agar halaman 2 tidak meluap ke halaman 3
  try {
    const tableIdx = body.getChildIndex(lampiranTable);

    // 1. Rapikan paragraf kosong di atas tabel (antara "Tanggal:..." dan tabel)
    // Di template ada 3 paragraf kosong, cukup sisakan 1 paragraf ringkas (6 pt)
    let aboveEmptyCount = 0;
    for (let u = tableIdx - 1; u >= 0; u--) {
      const el = body.getChild(u);
      if (el.getType() === DocumentApp.ElementType.PARAGRAPH) {
        const p = el.asParagraph();
        if (p.getText().trim() === "") {
          aboveEmptyCount++;
          if (aboveEmptyCount > 1) {
            try { p.clear(); } catch (e) {}
            p.setFontSize(1).setSpacingBefore(0).setSpacingAfter(0).setLineSpacing(1.0);
          } else {
            p.setFontSize(6).setSpacingBefore(0).setSpacingAfter(0).setLineSpacing(1.0);
          }
        } else {
          break; // Berhenti ketika menemukan teks (misal Tanggal)
        }
      } else {
        break;
      }
    }

    // 2. Rapikan paragraf kosong di bawah tabel (antara tabel dan titi mangsa tanda tangan)
    // Di template ada 2 paragraf kosong, cukup sisakan 1 paragraf ringkas (6 pt)
    let belowEmptyCount = 0;
    for (let d = tableIdx + 1; d < body.getNumChildren(); d++) {
      const el = body.getChild(d);
      if (el.getType() === DocumentApp.ElementType.PARAGRAPH) {
        const p = el.asParagraph();
        if (p.getText().trim() === "") {
          belowEmptyCount++;
          if (belowEmptyCount > 1) {
            try { p.clear(); } catch (e) {}
            p.setFontSize(1).setSpacingBefore(0).setSpacingAfter(0).setLineSpacing(1.0);
          } else {
            p.setFontSize(6).setSpacingBefore(0).setSpacingAfter(0).setLineSpacing(1.0);
          }
        } else {
          break; // Berhenti ketika menemukan titi mangsa (Pontianak, ...)
        }
      } else {
        break;
      }
    }
  } catch (eSp) {}
}

/**
 * Mengisi nilai sel dan memformat tampilan baris data lampiran pegawai secara efisien
 */
function fillLampiranRow(row, idx, p, headerRow, colWidths) {
  const numCells = row.getNumCells();
  const peranColIdx = numCells - 1; // Kolom terakhir selalu 'Peran'
  const jabColIdx = 4;              // Kolom ke-4 selalu 'Jabatan'

  // Seragamkan tinggi cell per baris agar rapi & hemat ruang
  try {
    row.setMinimumHeight(22);
  } catch (eH) {}

  for (let c = 0; c < numCells; c++) {
    const cell = row.getCell(c);
    let val = "";
    let align = DocumentApp.HorizontalAlignment.LEFT;

    if (c === 0) {
      val = String(idx + 1);
      align = DocumentApp.HorizontalAlignment.CENTER;
    } else if (c === 1) {
      val = p.nama || "";
      align = DocumentApp.HorizontalAlignment.LEFT;
    } else if (c === 2) {
      val = p.nip || "";
      align = DocumentApp.HorizontalAlignment.CENTER;
    } else if (c === 3) {
      val = p.pangkat_gol || "";
      align = DocumentApp.HorizontalAlignment.CENTER;
    } else if (c === jabColIdx) {
      val = p.jabatan || "";
      align = DocumentApp.HorizontalAlignment.LEFT;
    } else if (c === peranColIdx) {
      val = p.peran || "Peserta";
      align = DocumentApp.HorizontalAlignment.CENTER;
    } else {
      val = "";
      align = DocumentApp.HorizontalAlignment.LEFT;
    }

    cell.setText(val);
    cell.setPaddingTop(2).setPaddingBottom(2).setPaddingLeft(4).setPaddingRight(4);

    // Posisi tulisan vertikal diatur ke tengah (middle)
    cell.setVerticalAlignment(DocumentApp.VerticalAlignment.CENTER);

    try {
      if (colWidths && colWidths[c] && colWidths[c] > 0) {
        cell.setWidth(colWidths[c]);
      } else if (headerRow && headerRow.getNumCells() > c) {
        const hw = headerRow.getCell(c).getWidth();
        if (hw && hw > 0) cell.setWidth(hw);
      }
    } catch (eW) {}

    const numChildren = cell.getNumChildren();
    for (let pIdx = 0; pIdx < numChildren; pIdx++) {
      const child = cell.getChild(pIdx);
      if (child.getType() === DocumentApp.ElementType.PARAGRAPH) {
        const pElem = child.asParagraph();
        pElem.setFontFamily("Bookman Old Style");
        pElem.setFontSize(10);
        pElem.setBold(false); // Pastikan TIDAK BOLD
        pElem.setSpacingBefore(0);
        pElem.setSpacingAfter(0);
        pElem.setLineSpacing(1.15);
        pElem.setAlignment(align);
      }
    }
  }
}

/**
 * Menghapus bagian lampiran dari template jika hanya 1 orang (Aman & Bebas TypeError)
 */
function removeLampiranSection(body) {
  const numChildren = body.getNumChildren();
  let lampiranStartIndex = -1;

  for (let i = 0; i < numChildren; i++) {
    const child = body.getChild(i);
    const text = getElementText(child);
    if (text) {
      const clean = text.trim();
      if (clean === "Lampiran" || 
          (clean.indexOf("Lampiran") !== -1 && clean.indexOf("Nomor") !== -1) ||
          clean.startsWith("Lampiran\nNomor") ||
          clean.startsWith("Lampiran\rNomor")) {
        lampiranStartIndex = i;
        break;
      }
    }
  }

  if (lampiranStartIndex !== -1) {
    // Mundur ke belakang untuk mencakup paragraf kosong / PageBreak tepat sebelum lampiran
    while (lampiranStartIndex > 0) {
      const prevChild = body.getChild(lampiranStartIndex - 1);
      const prevType = prevChild.getType();
      const prevText = getElementText(prevChild).trim();
      if (prevType === DocumentApp.ElementType.PAGE_BREAK || 
          (prevType === DocumentApp.ElementType.PARAGRAPH && prevText === "")) {
        lampiranStartIndex--;
      } else {
        break;
      }
    }

    // Hapus seluruh elemen mulai dari lampiranStartIndex hingga elemen terakhir
    for (let j = body.getNumChildren() - 1; j >= lampiranStartIndex; j--) {
      try {
        body.removeChild(body.getChild(j));
      } catch (e) {
        // Abaikan jika elemen terakhir adalah elemen struktural non-removable
      }
    }

    // Bersihkan empty paragraph di akhir dokumen agar tidak menyisakan halaman kosong
    cleanTrailingEmptyParagraphs(body);
  }
}

/**
 * Membersihkan elemen kosong dan PageBreak yang berada DI AKHIR DOKUMEN (setelah seluruh konten selesai).
 * PENTING: Fungsi ini TIDAK BOLEH menghapus paragraf kosong di dalam konten (seperti spasi tanda tangan pejabat di atas nama).
 */
function cleanTrailingEmptyParagraphs(body) {
  if (!body) return;

  const numChildren = body.getNumChildren();
  let lastContentIdx = -1;

  // 1. Cari indeks elemen terakhir yang memuat konten nyata (tabel atau paragraf dengan teks/gambar)
  for (let i = numChildren - 1; i >= 0; i--) {
    const child = body.getChild(i);
    const cType = child.getType();
    if (cType === DocumentApp.ElementType.TABLE) {
      lastContentIdx = i;
      break;
    } else if (cType === DocumentApp.ElementType.PARAGRAPH) {
      const p = child.asParagraph();
      if (p.getText().trim() !== "") {
        lastContentIdx = i;
        break;
      }
      let hasRealContent = false;
      for (let c = 0; c < p.getNumChildren(); c++) {
        const ct = p.getChild(c).getType();
        if (ct === DocumentApp.ElementType.INLINE_IMAGE || ct === DocumentApp.ElementType.EQUATION) {
          hasRealContent = true;
          break;
        }
      }
      if (hasRealContent) {
        lastContentIdx = i;
        break;
      }
    } else {
      lastContentIdx = i;
      break;
    }
  }

  // Jika tidak ditemukan konten atau elemen konten berada di akhir dokumen,
  // maka tidak ada trailing empty paragraph yang perlu dihapus. Spasi tanda tangan tetap 100% aman.
  if (lastContentIdx === -1 || lastContentIdx >= body.getNumChildren() - 1) {
    return;
  }

  // 2. Hapus elemen kosong yang HANYA berada SETELAH lastContentIdx (dari belakang ke depan)
  while (body.getNumChildren() > lastContentIdx + 2) {
    const candidateIdx = body.getNumChildren() - 2;
    if (candidateIdx <= lastContentIdx) break;
    try {
      body.removeChild(body.getChild(candidateIdx));
    } catch (eRem) {
      break;
    }
  }

  // 3. Elemen struktural terakhir (yang berada setelah lastContentIdx) diatur ke 1pt agar tidak memicu halaman baru
  if (body.getNumChildren() > lastContentIdx + 1) {
    const lastEl = body.getChild(body.getNumChildren() - 1);
    if (lastEl.getType() === DocumentApp.ElementType.PARAGRAPH) {
      const pLast = lastEl.asParagraph();
      try { pLast.clear(); } catch (e) {}
      pLast.setFontSize(1).setSpacingBefore(0).setSpacingAfter(0).setLineSpacing(1.0);
    }
  }
}

function getElementText(elem) {
  if (!elem) return "";
  const type = elem.getType();
  if (type === DocumentApp.ElementType.PARAGRAPH) {
    return elem.asParagraph().getText();
  } else if (type === DocumentApp.ElementType.TABLE) {
    return getTableText(elem.asTable());
  } else if (type === DocumentApp.ElementType.LIST_ITEM) {
    return elem.asListItem().getText();
  } else if (type === DocumentApp.ElementType.TEXT) {
    return elem.asText().getText();
  }
  return "";
}

function getRowText(row) {
  if (!row) return "";
  let str = "";
  for (let c = 0; c < row.getNumCells(); c++) {
    str += " " + row.getCell(c).getText();
  }
  return str;
}

function getTableText(table) {
  if (!table) return "";
  let str = "";
  for (let r = 0; r < table.getNumRows(); r++) {
    str += getRowText(table.getRow(r));
  }
  return str;
}

/**
 * Menangani konsiderans Menimbang butir b
 */
function handleMenimbangClauseB(body, includeMenimbangB) {
  if (!includeMenimbangB) {
    const clauseText = "bahwa untuk pelaksanaannya perlu dikeluarkan Surat Tugas Kepala BPS Provinsi Kalimantan Barat;";
    body.replaceText(clauseText, "");

    // Bersihkan baris/paragraf kosong di tabel konsiderans
    try {
      const tables = body.getTables();
      for (let i = 0; i < tables.length; i++) {
        const t = tables[i];
        for (let r = 0; r < t.getNumRows(); r++) {
          const row = t.getRow(r);
          for (let c = 0; c < row.getNumCells(); c++) {
            const cell = row.getCell(c);
            for (let pIdx = cell.getNumChildren() - 1; pIdx >= 0; pIdx--) {
              const child = cell.getChild(pIdx);
              if (child.getType() === DocumentApp.ElementType.PARAGRAPH) {
                const p = child.asParagraph();
                if (p.getText().trim() === "" && cell.getNumChildren() > 1) {
                  try { cell.removeChild(child); } catch (e) {}
                }
              }
            }
          }
        }
      }
    } catch (errCleanB) {}
  }
}

/**
 * Menangani nama pejabat dan jabatan penandatangan
 */
function handleSignatoryBlock(body, payload) {
  const nama = payload.pejabatNama && payload.pejabatNama.trim() !== "" ? payload.pejabatNama.trim() : "Muh Saichudin";
  const rawJabatan = payload.pejabatJabatan && payload.pejabatJabatan.trim() !== "" ? payload.pejabatJabatan.trim() : "Kepala Badan Pusat Statistik Provinsi Kalimantan Barat";
  const nip = payload.pejabatNip ? payload.pejabatNip.trim() : "";

  // 1. Tentukan Pemisahan 2 Baris Jabatan yang Rapi Sesuai Format Resmi BPS Kalbar
  let line1 = "Kepala Badan Pusat Statistik";
  let line2 = "Provinsi Kalimantan Barat,";

  if (rawJabatan.indexOf("\n") !== -1) {
    const parts = rawJabatan.split("\n");
    line1 = parts[0].trim();
    line2 = parts.slice(1).join(" ").trim();
    if (line2 && !line2.endsWith(",")) line2 += ",";
  } else if (rawJabatan.indexOf("Provinsi Kalimantan Barat") !== -1) {
    const idx = rawJabatan.indexOf("Provinsi Kalimantan Barat");
    const prefix = rawJabatan.substring(0, idx).trim();
    line1 = prefix || "Kepala Badan Pusat Statistik";
    line2 = "Provinsi Kalimantan Barat,";
  } else if (rawJabatan.length > 30) {
    const words = rawJabatan.split(" ");
    const mid = Math.ceil(words.length / 2);
    line1 = words.slice(0, mid).join(" ");
    line2 = words.slice(mid).join(" ") + ",";
  } else {
    line1 = rawJabatan + ",";
    line2 = "";
  }

  // 2. Kumpulkan Semua Paragraf yang Mengandung Penanda Jabatan
  const targetJabParagraphs = [];

  function scanForJabParagraphs(container) {
    const numChildren = container.getNumChildren();
    for (let i = 0; i < numChildren; i++) {
      const child = container.getChild(i);
      const cType = child.getType();
      if (cType === DocumentApp.ElementType.PARAGRAPH) {
        const text = child.asParagraph().getText();
        if (text.indexOf("<<Jabttd>>") !== -1 || 
            text.indexOf("<<jabttd>>") !== -1 ||
            text.indexOf("<<Jabttd>>,") !== -1 ||
            text.indexOf("[JABATAN_PEJABAT]") !== -1 ||
            text.indexOf("{{JABATAN_PEJABAT}}") !== -1 ||
            text.trim() === "Kepala Badan Pusat Statistik Provinsi Kalimantan Barat" ||
            text.trim() === "Kepala Badan Pusat Statistik Provinsi Kalimantan Barat," ||
            text.trim() === "Kepala Badan Pusat Statistik" ||
            text.trim() === "Kepala Badan Pusat Statistik,") {
          targetJabParagraphs.push(child.asParagraph());
        }
      } else if (cType === DocumentApp.ElementType.TABLE) {
        const t = child.asTable();
        for (let r = 0; r < t.getNumRows(); r++) {
          const row = t.getRow(r);
          for (let c = 0; c < row.getNumCells(); c++) {
            scanForJabParagraphs(row.getCell(c));
          }
        }
      }
    }
  }

  scanForJabParagraphs(body);

  // Proses dari elemen terbawah ke atas (reverse) agar penambahan baris paragraf tidak menggeser index elemen lain
  targetJabParagraphs.reverse();

  targetJabParagraphs.forEach(pJab => {
    try {
      const parent = pJab.getParent();
      const childIdx = parent.getChildIndex(pJab);

      // Cari paragraf titi mangsa (tanggal) tepat di atas jabatan
      let pDate = null;
      if (childIdx > 0) {
        const prevChild = parent.getChild(childIdx - 1);
        if (prevChild.getType() === DocumentApp.ElementType.PARAGRAPH) {
          pDate = prevChild.asParagraph();
        }
      }

      // Ambil format margin dan inden dari titi mangsa (sebagai anchor perataan tengah)
      let indStart = null;
      let indFirst = null;
      let indEnd = null;

      if (pDate) {
        indStart = pDate.getIndentStart();
        indFirst = pDate.getIndentFirstLine();
        indEnd = pDate.getIndentEnd();

        // Pastikan titi mangsa diposisikan CENTER dan menggunakan font Bookman Old Style 12
        pDate.setAlignment(DocumentApp.HorizontalAlignment.CENTER);
        pDate.setFontFamily("Bookman Old Style").setFontSize(12);
        pDate.setBold(false).setItalic(false);
        pDate.setSpacingBefore(0).setSpacingAfter(0).setLineSpacing(1.15);
      }

      // Baris 1 Jabatan: "Kepala Badan Pusat Statistik"
      pJab.setText(line1);
      pJab.setFontFamily("Bookman Old Style").setFontSize(12);
      pJab.setBold(false).setItalic(false);
      pJab.setAlignment(DocumentApp.HorizontalAlignment.CENTER);
      if (indStart !== null && indStart !== undefined) pJab.setIndentStart(indStart);
      if (indFirst !== null && indFirst !== undefined) pJab.setIndentFirstLine(indFirst);
      if (indEnd !== null && indEnd !== undefined) pJab.setIndentEnd(indEnd);
      pJab.setSpacingBefore(0).setSpacingAfter(0).setLineSpacing(1.15);

      // Baris 2 Jabatan: "Provinsi Kalimantan Barat,"
      let pJab2 = null;
      if (line2 && line2.trim() !== "") {
        if (parent.getType() === DocumentApp.ElementType.BODY_SECTION) {
          pJab2 = parent.asBody().insertParagraph(childIdx + 1, line2);
        } else if (parent.getType() === DocumentApp.ElementType.TABLE_CELL) {
          pJab2 = parent.asTableCell().insertParagraph(childIdx + 1, line2);
        }

        if (pJab2) {
          pJab2.setFontFamily("Bookman Old Style").setFontSize(12);
          pJab2.setBold(false).setItalic(false);
          pJab2.setAlignment(DocumentApp.HorizontalAlignment.CENTER);
          if (indStart !== null && indStart !== undefined) pJab2.setIndentStart(indStart);
          if (indFirst !== null && indFirst !== undefined) pJab2.setIndentFirstLine(indFirst);
          if (indEnd !== null && indEnd !== undefined) pJab2.setIndentEnd(indEnd);
          pJab2.setSpacingBefore(0).setSpacingAfter(0).setLineSpacing(1.15);
        }
      }

      // Telusuri paragraf setelah jabatan untuk menemukan ruang tanda tangan & nama penandatangan
      let scanIdx = pJab2 ? childIdx + 2 : childIdx + 1;
      let pNama = null;
      const emptyParagraphs = [];
      const totalChildren = parent.getNumChildren();

      while (scanIdx < totalChildren) {
        const nextChild = parent.getChild(scanIdx);
        if (nextChild.getType() !== DocumentApp.ElementType.PARAGRAPH) {
          break;
        }

        const nextP = nextChild.asParagraph();
        const nextText = nextP.getText().trim();

        if (nextText === "") {
          emptyParagraphs.push(nextP);
          scanIdx++;
          continue;
        }

        if (nextText.indexOf("<<ttd") !== -1 || 
            nextText.indexOf("Muh Saichudin") !== -1 || 
            nextText.indexOf("[NAMA_PEJABAT]") !== -1 || 
            nextText.indexOf("{{NAMA_PEJABAT}}") !== -1 ||
            (nama && nextText.indexOf(nama) !== -1)) {
          pNama = nextP;
          break;
        } else {
          break;
        }
      }

      // Pastikan ada ruang tanda tangan standar (minimal 2 paragraf kosong berukuran 12pt Bookman Old Style)
      // persis seperti pada template surat tugas resmi BPS Kalbar
      while (emptyParagraphs.length < 2 && pNama) {
        const namaIdx = parent.getChildIndex(pNama);
        let newEmpty = null;
        if (parent.getType() === DocumentApp.ElementType.BODY_SECTION) {
          newEmpty = parent.asBody().insertParagraph(namaIdx, " ");
        } else if (parent.getType() === DocumentApp.ElementType.TABLE_CELL) {
          newEmpty = parent.asTableCell().insertParagraph(namaIdx, " ");
        }
        if (newEmpty) {
          try { newEmpty.clear(); } catch (e) {}
          emptyParagraphs.push(newEmpty);
        } else {
          break;
        }
      }

      // Format setiap baris ruang tanda tangan dengan Bookman Old Style 12pt line spacing 1.15
      emptyParagraphs.forEach(ep => {
        try { ep.clear(); } catch (e) {}
        ep.setFontFamily("Bookman Old Style").setFontSize(12);
        ep.setBold(false).setItalic(false);
        ep.setAlignment(DocumentApp.HorizontalAlignment.CENTER);
        if (indStart !== null && indStart !== undefined) ep.setIndentStart(indStart);
        if (indFirst !== null && indFirst !== undefined) ep.setIndentFirstLine(indFirst);
        if (indEnd !== null && indEnd !== undefined) ep.setIndentEnd(indEnd);
        ep.setSpacingBefore(0).setSpacingAfter(0).setLineSpacing(1.15);
      });

      // Format nama penandatangan
      if (pNama) {
        pNama.setText(nama);
        pNama.setFontFamily("Bookman Old Style").setFontSize(12);
        pNama.setBold(false).setItalic(false);
        pNama.setAlignment(DocumentApp.HorizontalAlignment.CENTER);
        if (indStart !== null && indStart !== undefined) pNama.setIndentStart(indStart);
        if (indFirst !== null && indFirst !== undefined) pNama.setIndentFirstLine(indFirst);
        if (indEnd !== null && indEnd !== undefined) pNama.setIndentEnd(indEnd);
        pNama.setSpacingBefore(0).setSpacingAfter(0).setLineSpacing(1.15);

        // Cek paragraf NIP jika ada tepat di bawah nama
        const pNamaIdx = parent.getChildIndex(pNama);
        if (pNamaIdx + 1 < parent.getNumChildren()) {
          const nipChild = parent.getChild(pNamaIdx + 1);
          if (nipChild.getType() === DocumentApp.ElementType.PARAGRAPH) {
            const nipP = nipChild.asParagraph();
            const nipText = nipP.getText().trim();
            if (nipText.indexOf("NIP") !== -1 || nipText.indexOf("[NIP_PEJABAT]") !== -1 || nipText.indexOf("{{NIP_PEJABAT}}") !== -1) {
              if (nip) {
                nipP.setText("NIP. " + nip);
                nipP.setFontFamily("Bookman Old Style").setFontSize(12);
                nipP.setBold(false).setItalic(false);
                nipP.setAlignment(DocumentApp.HorizontalAlignment.CENTER);
                if (indStart !== null && indStart !== undefined) nipP.setIndentStart(indStart);
                if (indFirst !== null && indFirst !== undefined) nipP.setIndentFirstLine(indFirst);
                if (indEnd !== null && indEnd !== undefined) nipP.setIndentEnd(indEnd);
                nipP.setSpacingBefore(0).setSpacingAfter(0).setLineSpacing(1.15);
              } else {
                try {
                  parent.removeChild(nipChild);
                } catch (eRemNip) {
                  try { nipP.clear(); } catch (eCl) {}
                  nipP.setSpacingBefore(0).setSpacingAfter(0).setFontSize(1).setLineSpacing(1.0);
                }
              }
            }
          }
        }
      }
    } catch (errP) {
      Logger.log("Peringatan format blok tanda tangan: " + errP);
    }
  });

  // 4. Fallback pembersihan teks literal sisa jika masih ada placeholder ttd yang belum terganti
  try {
    body.replaceText("<<ttd>>", nama);
    body.replaceText("<<ttd>", nama);
    body.replaceText("\\[NAMA_PEJABAT\\]", nama);
    body.replaceText("\\{\\{NAMA_PEJABAT\\}\\}", nama);
    if (nip) {
      body.replaceText("\\[NIP_PEJABAT\\]", "NIP. " + nip);
      body.replaceText("\\{\\{NIP_PEJABAT\\}\\}", "NIP. " + nip);
    } else {
      body.replaceText("\\[NIP_PEJABAT\\]", "");
      body.replaceText("\\{\\{NIP_PEJABAT\\}\\}", "");
    }
  } catch (eFallback) {}
}

function cleanUpStrayBold(body) {
  if (!body) return;

  // 1. Bersihkan bold di tabel konsiderans & penugasan
  try {
    const tables = body.getTables();
    for (let i = 0; i < tables.length; i++) {
      const t = tables[i];
      const tText = getTableText(t);
      // Hanya proses tabel konsiderans & penugasan, jangan sentuh baris header tabel lampiran
      if (tText.indexOf("Menimbang") !== -1 || tText.indexOf("Mengingat") !== -1 || 
          tText.indexOf("Kepada") !== -1 || tText.indexOf("Untuk") !== -1) {
        for (let r = 0; r < t.getNumRows(); r++) {
          const row = t.getRow(r);
          for (let c = 0; c < row.getNumCells(); c++) {
            const cell = row.getCell(c);
            for (let pIdx = 0; pIdx < cell.getNumChildren(); pIdx++) {
              const child = cell.getChild(pIdx);
              if (child.getType() === DocumentApp.ElementType.PARAGRAPH) {
                child.asParagraph().setBold(false);
              }
            }
          }
        }
      }
    }
  } catch (errTbl) {
    Logger.log("Peringatan cleanUpStrayBold tabel: " + errTbl);
  }

  // 2. Pastikan teks judul 'SURAT TUGAS' tetap tebal, sedangkan 'Memberi Tugas:' normal
  try {
    const paragraphs = body.getParagraphs();
    for (let p = 0; p < paragraphs.length; p++) {
      const text = paragraphs[p].getText().trim();
      if (text === "SURAT TUGAS") {
        paragraphs[p].setBold(true);
      } else if (text === "Memberi Tugas:") {
        paragraphs[p].setBold(false);
      }
    }
  } catch (errP) {
    Logger.log("Peringatan cleanUpStrayBold paragraf: " + errP);
  }
}

/**
 * ENGINE PRESISI: Membuat Dokumen Baru Standar F4 dengan Ukuran Kolom & Margin Akurat
 */
function createDocumentFromScratch(docTitle, targetFolder, payload, nomorData) {
  const doc = DocumentApp.create(docTitle);
  const file = DriveApp.getFileById(doc.getId());
  targetFolder.addFile(file);
  DriveApp.getRootFolder().removeFile(file);

  const body = doc.getBody();

  // Ukuran Margin F4 / Folio Presisi: Top 2.0cm (56.7pt), Bottom 2.0cm (56.7pt), Left 2.5cm (70.8pt), Right 2.0cm (56.7pt)
  body.setMarginTop(56.7);
  body.setMarginBottom(56.7);
  body.setMarginLeft(70.8);
  body.setMarginRight(56.7);

  // 1. KOP SURAT
  try {
    const logoBlob = Utilities.newBlob(Utilities.base64Decode(BPS_LOGO_BASE64), "image/png", "logo_bps.png");
    const pLogo = body.appendParagraph(" ");
    try { pLogo.clear(); } catch (e) {}
    pLogo.setAlignment(DocumentApp.HorizontalAlignment.CENTER);
    pLogo.setSpacingAfter(2);
    pLogo.appendInlineImage(logoBlob).setWidth(68).setHeight(53);
  } catch (errLogo) {
    Logger.log("Gagal menyisipkan inline logo: " + errLogo);
  }

  const pKop1 = body.appendParagraph("BADAN PUSAT STATISTIK");
  pKop1.setFontFamily("Arial").setFontSize(12).setBold(true).setItalic(true)
       .setAlignment(DocumentApp.HorizontalAlignment.CENTER).setSpacingAfter(0).setLineSpacing(1.0);

  const pKop2 = body.appendParagraph("PROVINSI KALIMANTAN BARAT");
  pKop2.setFontFamily("Arial").setFontSize(12).setBold(true).setItalic(true)
       .setAlignment(DocumentApp.HorizontalAlignment.CENTER).setSpacingAfter(6).setLineSpacing(1.0);

  // 2. JUDUL SURAT TUGAS
  const pJudul = body.appendParagraph("SURAT TUGAS");
  pJudul.setFontFamily("Bookman Old Style").setFontSize(12).setBold(true)
        .setAlignment(DocumentApp.HorizontalAlignment.CENTER).setSpacingAfter(2).setLineSpacing(1.0);

  const pNomor = body.appendParagraph("NOMOR : " + nomorData.nomorSurat);
  pNomor.setFontFamily("Bookman Old Style").setFontSize(12)
        .setAlignment(DocumentApp.HorizontalAlignment.CENTER).setSpacingAfter(8).setLineSpacing(1.0);

  // 3. TABEL KONSIDERANS
  let menimbangText = "a. bahwa merujuk surat dari " + (payload.rujukanPejabat || "") + " nomor " + 
                      (payload.rujukanNomor || "") + " hal " + (payload.rujukanPerihal || "") + 
                      ", maka dipandang perlu menyesuaikan dengan jadwal kegiatan tersebut;\n" +
                      "b. bahwa untuk pelaksanaannya perlu dikeluarkan Surat Tugas Kepala BPS Provinsi Kalimantan Barat;";

  const mengingatText = "1. Undang-Undang Nomor 16 Tahun 1997 tentang Statistik;\n" +
                        "2. Peraturan Pemerintah Nomor 51 Tahun 1999 tentang Penyelenggaraan Statistik;\n" +
                        "3. Peraturan Pemerintah Nomor 45 Tahun 2013 tentang Tata Cara Pelaksanaan APBN sebagaimana diubah PP 50/2018;\n" +
                        "4. Peraturan Presiden Nomor 86 Tahun 2007 jo Perpres Nomor 1 Tahun 2025 tentang BPS;\n" +
                        "5. Peraturan Badan Pusat Statistik Nomor 3 Tahun 2026 tentang Organisasi dan Tata Kerja BPS Provinsi dan BPS Kabupaten/Kota.";

  const tKonsiderans = body.appendTable([
    ["Menimbang", ":", menimbangText],
    ["Mengingat", ":", mengingatText]
  ]);
  tKonsiderans.setBorderWidth(0);
  formatBorderlessTable(tKonsiderans, [95, 15, 370]);

  // 4. DIKTUM MEMBERI TUGAS
  const pMemberi = body.appendParagraph("Memberi Tugas:");
  pMemberi.setFontFamily("Bookman Old Style").setFontSize(12).setBold(false)
          .setAlignment(DocumentApp.HorizontalAlignment.CENTER).setSpacingBefore(6).setSpacingAfter(6);

  const isSingle = payload.pegawaiList.length === 1;

  // 5. KEPADA
  if (isSingle) {
    const p = payload.pegawaiList[0];
    const tKepada = body.appendTable([
      ["Kepada", ":", "Nama", ":", p.nama || ""],
      ["", "", "NIP", ":", p.nip || ""],
      ["", "", "Pangkat/Gol", ":", p.pangkat_gol || ""],
      ["", "", "Jabatan", ":", p.jabatan || ""]
    ]);
    tKepada.setBorderWidth(0);
    formatBorderlessTable(tKepada, [95, 15, 85, 15, 270]);
  } else {
    const tKepada = body.appendTable([
      ["Kepada", ":", "Nama", ":", "(terlampir)"],
      ["", "", "NIP", ":", "(terlampir)"],
      ["", "", "Pangkat/Gol", ":", "(terlampir)"],
      ["", "", "Jabatan", ":", "(terlampir)"]
    ]);
    tKepada.setBorderWidth(0);
    formatBorderlessTable(tKepada, [95, 15, 85, 15, 270]);
  }

  // 6. UNTUK
  const tUntuk = body.appendTable([
    ["Untuk", ":", payload.tujuanTugas || ""]
  ]);
  tUntuk.setBorderWidth(0);
  formatBorderlessTable(tUntuk, [95, 15, 370]);

  // 7. BLOK TITI MANGSA & TANDA TANGAN (HALAMAN UTAMA) - Struktur Rapi & Anti-Terpotong
  const ttdJabatan = payload.pejabatJabatan || "Kepala Badan Pusat Statistik\nProvinsi Kalimantan Barat,";
  const ttdNama = payload.pejabatNama || "Muh Saichudin";
  const ttdData = [
    ["", (payload.tempatPenetapan || "Pontianak") + ", " + (payload.tanggalPenetapan || formatTanggalIndonesia(new Date()))],
    ["", ttdJabatan],
    ["", "\n\n\n"],
    ["", ttdNama]
  ];
  if (payload.pejabatNip) {
    ttdData.push(["", "NIP. " + payload.pejabatNip]);
  }

  const ttdTable = body.appendTable(ttdData);
  ttdTable.setBorderWidth(0);
  formatBorderlessTable(ttdTable, [240, 244]);
  for (let r = 0; r < ttdTable.getNumRows(); r++) {
    const cell = ttdTable.getRow(r).getCell(1);
    for (let cIdx = 0; cIdx < cell.getNumChildren(); cIdx++) {
      const p = cell.getChild(cIdx);
      if (p.getType() === DocumentApp.ElementType.PARAGRAPH) {
        p.asParagraph().setAlignment(DocumentApp.HorizontalAlignment.CENTER);
        p.asParagraph().setBold(false);
      }
    }
  }

  // 8. JIKA KOLEKTIF: BUAT HALAMAN LAMPIRAN
  if (!isSingle) {
    body.appendPageBreak();

    const pLampHeader = body.appendParagraph("Lampiran\nNomor\t: " + nomorData.nomorSurat + "\nTanggal\t: " + (payload.tanggalPenetapan || formatTanggalIndonesia(new Date())) + "\n");
    pLampHeader.setFontFamily("Bookman Old Style").setFontSize(11).setSpacingAfter(8);

    const lampData = [
      ["No", "Nama", "NIP", "Pangkat/Gol", "Jabatan", "Peran"]
    ];

    payload.pegawaiList.forEach((p, idx) => {
      lampData.push([
        String(idx + 1),
        p.nama || "",
        p.nip || "",
        p.pangkat_gol || "",
        p.jabatan || "",
        p.peran || "Peserta"
      ]);
    });

    const tLampiran = body.appendTable(lampData);
    tLampiran.setBorderWidth(1);

    const lampColWidths = [35, 185, 155, 115, 223, 95];
    for (let r = 0; r < tLampiran.getNumRows(); r++) {
      const row = tLampiran.getRow(r);
      row.setMinimumHeight(r === 0 ? 24 : 28);
      for (let c = 0; c < row.getNumCells(); c++) {
        const cell = row.getCell(c);
        cell.setVerticalAlignment(DocumentApp.VerticalAlignment.CENTER);
        if (c < lampColWidths.length) {
          cell.setWidth(lampColWidths[c]);
        }
        cell.setPaddingTop(3).setPaddingBottom(3).setPaddingLeft(4).setPaddingRight(4);
        const pElem = cell.getChild(0);
        if (pElem && pElem.getType() === DocumentApp.ElementType.PARAGRAPH) {
          pElem.setFontFamily("Bookman Old Style").setFontSize(10).setSpacingBefore(0).setSpacingAfter(0).setLineSpacing(1.15);
          if (r === 0) {
            pElem.setBold(true);
            pElem.asParagraph().setAlignment(DocumentApp.HorizontalAlignment.CENTER);
          } else {
            pElem.setBold(false); // Data pegawai regular/tidak tebal
            if (c === 0 || c === 2 || c === 3 || c === 5) {
              pElem.asParagraph().setAlignment(DocumentApp.HorizontalAlignment.CENTER);
            } else {
              pElem.asParagraph().setAlignment(DocumentApp.HorizontalAlignment.LEFT);
            }
          }
        }
      }
    }

    const pSp = body.appendParagraph(" ");
    try { pSp.clear(); } catch (e) {}
    const ttdLampData = [
      ["", (payload.tempatPenetapan || "Pontianak") + ", " + (payload.tanggalPenetapan || formatTanggalIndonesia(new Date()))],
      ["", ttdJabatan],
      ["", "\n\n\n"],
      ["", ttdNama]
    ];
    if (payload.pejabatNip) {
      ttdLampData.push(["", "NIP. " + payload.pejabatNip]);
    }

    const ttdLampTable = body.appendTable(ttdLampData);
    ttdLampTable.setBorderWidth(0);
    formatBorderlessTable(ttdLampTable, [564, 244]);
    for (let r = 0; r < ttdLampTable.getNumRows(); r++) {
      const cell = ttdLampTable.getRow(r).getCell(1);
      for (let cIdx = 0; cIdx < cell.getNumChildren(); cIdx++) {
        const p = cell.getChild(cIdx);
        if (p.getType() === DocumentApp.ElementType.PARAGRAPH) {
          p.asParagraph().setAlignment(DocumentApp.HorizontalAlignment.CENTER);
          p.asParagraph().setBold(false);
        }
      }
    }
  }

  doc.saveAndClose();
  return file;
}

/**
 * Helper memformat tabel tanpa garis dengan lebar kolom dan padding rapat
 */
function formatBorderlessTable(table, colWidths) {
  table.setBorderWidth(0);
  for (let r = 0; r < table.getNumRows(); r++) {
    const row = table.getRow(r);
    for (let c = 0; c < row.getNumCells(); c++) {
      const cell = row.getCell(c);
      if (c < colWidths.length) {
        cell.setWidth(colWidths[c]);
      }
      cell.setPaddingTop(1.5).setPaddingBottom(1.5).setPaddingLeft(2).setPaddingRight(2);
      for (let pIdx = 0; pIdx < cell.getNumChildren(); pIdx++) {
        const child = cell.getChild(pIdx);
        if (child.getType() === DocumentApp.ElementType.PARAGRAPH) {
          child.asParagraph().setFontFamily("Bookman Old Style").setFontSize(11)
               .setSpacingAfter(0).setLineSpacing(1.15);
        }
      }
    }
  }
}

/**
 * Menghapus Section Break pada dokumen via Docs API (hanya untuk mode tunggal/1 orang)
 * agar dokumen Google Docs dan PDF bersih menjadi tepat 1 halaman tanpa halaman kosong di belakangnya.
 */
function cleanExcessSectionBreaksViaApi(docId, isSingle) {
  if (!docId) return;
  try {
    const token = ScriptApp.getOAuthToken();
    const getUrl = "https://docs.googleapis.com/v1/documents/" + docId;
    const res = UrlFetchApp.fetch(getUrl, {
      method: "get",
      headers: {
        "Authorization": "Bearer " + token
      },
      muteHttpExceptions: true
    });

    if (res.getResponseCode() !== 200) {
      Logger.log("Docs API GET catatan: " + res.getContentText());
      return;
    }

    const docData = JSON.parse(res.getContentText());
    const content = docData.body && docData.body.content ? docData.body.content : [];
    
    // Kumpulkan seluruh elemen sectionBreak
    const sectionBreaks = [];
    for (let i = 0; i < content.length; i++) {
      const el = content[i];
      if (el.sectionBreak && el.startIndex !== undefined && el.endIndex !== undefined) {
        sectionBreaks.push(el);
      }
    }

    const requests = [];
    // Mode tunggal: keepCount = 0 (hapus semua)
    // Mode kolektif: keepCount = 1 (pertahankan hanya 1 section break untuk halaman lampiran)
    const keepCount = isSingle ? 0 : 1;

    for (let s = sectionBreaks.length - 1; s >= keepCount; s--) {
      const sb = sectionBreaks[s];
      requests.push({
        deleteContentRange: {
          range: {
            startIndex: sb.startIndex,
            endIndex: sb.endIndex
          }
        }
      });
    }

    if (requests.length > 0) {
      const updateUrl = "https://docs.googleapis.com/v1/documents/" + docId + ":batchUpdate";
      const updateRes = UrlFetchApp.fetch(updateUrl, {
        method: "post",
        headers: {
          "Authorization": "Bearer " + token,
          "Content-Type": "application/json"
        },
        payload: JSON.stringify({ requests: requests }),
        muteHttpExceptions: true
      });
      Logger.log("Docs API BatchUpdate sectionBreaks status: " + updateRes.getResponseCode());
    }
  } catch (err) {
    Logger.log("Peringatan cleanExcessSectionBreaksViaApi: " + err);
  }
}

function removeSectionBreaksViaApi(docId) {
  cleanExcessSectionBreaksViaApi(docId, true);
}
